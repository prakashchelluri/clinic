# Leave DATABASE_URL unset to use embedded Postgres (PGlite) in ./data for local dev.
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require
COOKIE_SECRET=change-me-to-a-long-random-string
PORT=3000
# Public address used in patient links (confirm / cancel / reschedule). Defaults to the address the request came in on.
# APP_URL=https://your-clinic.onrender.com
# WhatsApp Cloud API (Meta). Without these, patient messages are prepared and kept in the outbox as "ready" but not sent.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# Incoming WhatsApp (webhook at /api/public/whatsapp). VERIFY_TOKEN: any string, typed again in Meta's dashboard.
# APP_SECRET: the Meta app's secret, used to check every call really comes from Meta (required in production).
# CLINIC: the clinic slug this number belongs to (one number, one clinic; or set messages.phoneNumberId in that clinic's settings).
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_CLINIC=sahitya
# WhatsApp assistant (Claude). Without a key every incoming chat goes to the front desk's WhatsApp page.
# ANTHROPIC_API_KEY=
# ASSISTANT_MODEL=claude-opus-5-5
# Object storage for uploads (Cloudflare R2 or any S3-compatible store). Leave unset to keep files on local disk (UPLOAD_DIR).
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_BUCKET=cubott
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
