# Leave DATABASE_URL unset to use embedded Postgres (PGlite) in ./data for local dev.
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require
COOKIE_SECRET=change-me-to-a-long-random-string
PORT=3000
# Public address used in patient links (confirm / cancel / reschedule). Defaults to the address the request came in on.
# APP_URL=https://your-clinic.onrender.com
# WhatsApp Cloud API (Meta). Without these, patient messages are prepared and kept in the outbox as "ready" but not sent.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
